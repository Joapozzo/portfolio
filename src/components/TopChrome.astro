---
import { getLangFromUrl, getAlternateLanguage, getRouteFromUrl, getLocalizedPath, languages } from '@/i18n';
import ThemeToggle from './ThemeToggle';
import MotionToggle from './MotionToggle';

const lang = getLangFromUrl(Astro.url);
const altLang = getAlternateLanguage(lang);
const route = getRouteFromUrl(Astro.url);
const altUrl = getLocalizedPath(route, altLang);
---

<div class="pointer-events-none fixed inset-x-0 top-0 z-50 pt-[var(--space-4)]">
  <div class="page-shell pointer-events-none">
    <div
      class="pointer-events-auto glass flex w-full items-center justify-between rounded-full px-[var(--space-4)] py-[var(--space-2)] shadow-[var(--shadow)]"
      data-align="chrome"
      data-testid="top-chrome"
    >
      <a href={getLocalizedPath('/', lang)} class="focus-ring rounded-full px-2 py-1 text-sm font-semibold tracking-tight">
        Joaquín Pozzo
      </a>
      <div class="flex items-center gap-1.5">
        <a
          href={altUrl}
          class="focus-ring rounded-full px-3 py-1.5 text-xs font-semibold text-[var(--fg-secondary)] hover:bg-[var(--fill)]"
          aria-label={`${altLang.toUpperCase()} — ${languages[altLang]}`}
          hreflang={altLang}
          data-testid="language-switch"
        >
          {altLang.toUpperCase()}
        </a>
        <ThemeToggle client:load />
        <MotionToggle client:load />
      </div>
    </div>
  </div>
</div>
