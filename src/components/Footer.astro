---
import { getLangFromUrl } from '@/i18n';
import { site } from '@/content/site';

const lang = getLangFromUrl(Astro.url);
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--separator)] pb-28 pt-[var(--space-6)] md:pb-32">
  <div
    class="page-shell flex flex-col items-start justify-between gap-[var(--space-5)] md:flex-row md:items-center"
    data-align="footer"
    data-testid="site-footer"
  >
    <div>
      <p class="text-sm font-semibold tracking-tight" data-align="title">{site.name}</p>
      <p class="caption mt-[var(--space-2)]">
        {lang === 'es'
          ? 'Desarrollador web en Gentío MKT desde 2023 · Córdoba, AR'
          : 'Web developer at Gentío MKT since 2023 · Córdoba, AR'}
      </p>
      <p class="caption mt-[var(--space-2)]">© {year}</p>
    </div>
    <div class="flex items-center gap-[var(--space-3)]">
      <a class="focus-ring rounded-full bg-[var(--fill)] px-3 py-2 text-sm font-medium" href={site.github.url} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="focus-ring rounded-full bg-[var(--fill)] px-3 py-2 text-sm font-medium" href={site.linkedin.url} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a class="focus-ring rounded-full bg-[var(--fill)] px-3 py-2 text-sm font-medium" href={`mailto:${site.email}`}>Email</a>
    </div>
  </div>
</footer>
