# --- Joaquín AI (Google Gemini free tier) ---
# 1. Open https://aistudio.google.com/apikey
# 2. Create an API key (free)
# 3. Paste it here. Without this key the chat widget shows "próximamente".
GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
# AI_PROVIDER=gemini

# --- Optional durable rate limits (Upstash Redis free tier) ---
# Leave empty to use in-memory limits (resets on cold start).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Contact form (pick one free option; otherwise mailto fallback) ---
# Web3Forms: https://web3forms.com (free) → Access Key
WEB3FORMS_ACCESS_KEY=
# Or Resend free tier: https://resend.com
# RESEND_API_KEY=
# RESEND_FROM=onboarding@resend.dev
