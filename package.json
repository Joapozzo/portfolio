{
  "name": "joaquinpozzo-portfolio",
  "type": "module",
  "version": "0.1.0",
  "description": "Personal portfolio for Joaquín Pozzo - Backend & Full Stack Developer",
  "author": "Joaquín Pozzo",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev --port 4321",
    "prebuild": "node scripts/sync-project-assets.mjs && node scripts/generate-cv.mjs && node scripts/generate-og.mjs",
    "build": "astro check && astro build",
    "assets:cv": "node scripts/generate-cv.mjs",
    "assets:og": "node scripts/generate-og.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "shots:capture": "node scripts/capture-project-shots.mjs",
    "shots:sync": "node scripts/sync-project-assets.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^7.1.7",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.21",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.10",
    "embla-carousel-react": "^8.6.0",
    "motion": "^14.12.0",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/pdfkit": "^0.17.7",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
